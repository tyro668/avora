{
  "name": "lmbp-server",
  "version": "0.1.0",
  "description": "LMBP server SDK: pair users' desktop apps and call their local models through OpenAI- and Anthropic-compatible APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    },
    "./engine": {
      "import": "./dist/engine/gateway.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "lmbp",
    "llm",
    "openai",
    "anthropic",
    "local-models",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tyro668/avora.git",
    "directory": "sdk/node"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "typescript": "^5.6.0"
  }
}
